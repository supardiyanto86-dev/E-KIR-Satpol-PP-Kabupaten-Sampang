        // ==========================================
        // UPDATE STATISTIK REALTIME
        // ==========================================
        function updateStatistikRealtime() {
            const barangRuangan = state.barang.filter(b => b.ruanganId === state.activeRuanganId);
            const mutasiRuangan = state.mutasi.filter(m => m.ruanganId === state.activeRuanganId);

            let totalBaik = 0;
            let totalRR = 0;
            let totalRB = 0;

            barangRuangan.forEach(item => {
                totalBaik += Number(item.baik || 0);
                totalRR += Number(item.rusakRingan || 0);
                totalRB += Number(item.rusakBerat || 0);
            });

            const totalSemua = totalBaik + totalRR + totalRB;

            document.getElementById('statTotalUnit').textContent = totalSemua;
            document.getElementById('statBaik').textContent = totalBaik;
            document.getElementById('statRusakRingan').textContent = totalRR;
            document.getElementById('statRusakBerat').textContent = totalRB;
            document.getElementById('badgeMutasiCount').textContent = mutasiRuangan.length;
        }

