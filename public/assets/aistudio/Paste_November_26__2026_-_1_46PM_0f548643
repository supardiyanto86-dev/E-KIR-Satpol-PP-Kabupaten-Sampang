            state.filterMutasi = tipe;
            document.getElementById('filterMutasiSemua').className = tipe === 'SEMUA' ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-white transition' : 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition';
            document.getElementById('filterMutasiMasuk').className = tipe === 'MASUK' ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 text-white transition' : 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition';
            document.getElementById('filterMutasiKeluar').className = tipe === 'KELUAR' ? 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 text-white transition' : 'px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-rose-50 hover:text-rose-700 transition';
            renderTabelMutasi();
        }

        function renderTabelMutasi() {
            const keyword = document.getElementById('searchInput').value.toLowerCase();
            const tbody = document.getElementById('tabelMutasiBody');
            const emptyState = document.getElementById('emptyMutasiState');

            const filtered = state.mutasi.filter(m => {
                const matchRuang = m.ruanganId === state.activeRuanganId;
                const matchTipe = state.filterMutasi === 'SEMUA' || m.jenis === state.filterMutasi;
                const matchKeyword = m.namaBarang.toLowerCase().includes(keyword) || m.asalTujuan.toLowerCase().includes(keyword);
                return matchRuang && matchTipe && matchKeyword;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            tbody.innerHTML = filtered.map(m => {
                const isMasuk = m.jenis === 'MASUK';
                return `
                <tr class="hover:bg-slate-50 transition">
                    <td class="py-3.5 px-4">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold ${isMasuk ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                            <i class="fa-solid ${isMasuk ? 'fa-arrow-down-left' : 'fa-arrow-up-right'}"></i>
                            MUTASI ${m.jenis}
                        </span>
                        <div class="text-xs text-slate-400 mt-1">${m.tanggal}</div>
                    </td>
                    <td class="py-3.5 px-4">
                        <div class="font-bold text-slate-800">${m.namaBarang}</div>
                        <div class="text-xs font-mono text-slate-500">${m.kodeBarang || '-'}</div>
                    </td>
                    <td class="py-3.5 px-4 text-center">
                        <span class="font-bold text-sm ${isMasuk ? 'text-emerald-600' : 'text-rose-600'}">
                            ${isMasuk ? '+' : '-'}${m.jumlah} Unit
                        </span>
                        <div class="text-[11px] text-slate-500">Kondisi: ${m.kondisi}</div>
                    </td>
                    <td class="py-3.5 px-4">
                        <div class="text-xs text-slate-400">${isMasuk ? 'Dari:' : 'Ke:'}</div>
                        <div class="font-semibold text-slate-700 text-sm">${m.asalTujuan}</div>
                    </td>
                    <td class="py-3.5 px-4">
                        <div class="text-xs text-slate-700 font-medium">${m.keterangan}</div>
                        <div class="text-[11px] text-slate-400 mt-0.5"><i class="fa-solid fa-user-check mr-1"></i>Oleh: ${m.petugas}</div>
                    </td>
                </tr>
                `;
            }).join('');
        }

        // ==========================================
        // TAMBAH & EDIT BARANG
        // ==========================================
        function simpanBarang(e) {
            e.preventDefault();
            const editId = document.getElementById('editBarangId').value;
            const baik = parseInt(document.getElementById('inputKondisiBaik').value) || 0;
            const rr = parseInt(document.getElementById('inputKondisiRR').value) || 0;
            const rb = parseInt(document.getElementById('inputKondisiRB').value) || 0;

            if (baik + rr + rb <= 0) {
                showToast('Jumlah total unit barang minimal harus 1!', 'error');
                return;
            }

            const dataBarang = {
                id: editId || 'BRG-' + Date.now(),
                ruanganId: state.activeRuanganId,
                kode: document.getElementById('inputKodeBarang').value,
                nama: document.getElementById('inputNamaBarang').value,
                merk: document.getElementById('inputMerkBarang').value,
                tahun: parseInt(document.getElementById('inputTahunBarang').value),
                baik: baik,
                rusakRingan: rr,
                rusakBerat: rb,
                fotoBarang: document.getElementById('inputFotoBarangUrl').value || document.getElementById('previewBarangImg').src,
                asnNama: document.getElementById('inputAsnNama').value,
                asnNip: document.getElementById('inputAsnNip').value,
                asnFoto: document.getElementById('inputFotoAsnUrl').value || document.getElementById('previewAsnImg').src
            };

            if (editId) {
                const idx = state.barang.findIndex(b => b.id === editId);
                if (idx !== -1) state.barang[idx] = dataBarang;
                showToast('Data & kondisi barang berhasil diperbarui!', 'success');
            } else {
                state.barang.unshift(dataBarang);
                // Otomatis catat ke mutasi masuk jika barang baru ditambahkan
                state.mutasi.unshift({
                    id: 'MUT-' + Date.now(),
                    ruanganId: state.activeRuanganId,
                    jenis: 'MASUK',
                    tanggal: getFormattedNow(),
                    kodeBarang: dataBarang.kode,
                    namaBarang: dataBarang.nama,
                    jumlah: baik + rr + rb,
                    kondisi: baik > 0 ? 'B' : (rr > 0 ? 'RR' : 'RB'),
                    asalTujuan: 'Pencatatan Inventaris Baru',
                    keterangan: `Input baru pemegang: ${dataBarang.asnNama}`,
                    petugas: 'Admin Ruangan'
                });
                showToast('Barang baru berhasil ditambahkan ke KIR!', 'success');
            }

            closeModal('modalBarang');
            renderCurrentView();
        }

        function editBarang(id) {
            const item = state.barang.find(b => b.id === id);
            if (!item) return;

            document.getElementById('modalBarangTitle').textContent = 'Edit Barang & Kondisi Realtime';
            document.getElementById('editBarangId').value = item.id;
            document.getElementById('inputKodeBarang').value = item.kode;
            document.getElementById('inputNamaBarang').value = item.nama;
            document.getElementById('inputMerkBarang').value = item.merk;
            document.getElementById('inputTahunBarang').value = item.tahun;
            document.getElementById('inputKondisiBaik').value = item.baik;
            document.getElementById('inputKondisiRR').value = item.rusakRingan;
            document.getElementById('inputKondisiRB').value = item.rusakBerat;
            document.getElementById('inputFotoBarangUrl').value = item.fotoBarang;
            document.getElementById('previewBarangImg').src = item.fotoBarang;
            document.getElementById('inputAsnNama').value = item.asnNama;
            document.getElementById('inputAsnNip').value = item.asnNip;
            document.getElementById('inputFotoAsnUrl').value = item.asnFoto;
            document.getElementById('previewAsnImg').src = item.asnFoto;

            openModal('modalBarang', true);
        }

        function hapusBarang(id) {
            const idx = state.barang.findIndex(b => b.id === id);
            if (idx !== -1) {
                const nama = state.barang[idx].nama;
                state.barang.splice(idx, 1);
                renderCurrentView();
                showToast(`Barang "${nama}" dihapus dari daftar.`, 'info');
            }
        }

        // ==========================================
        // PROSES MUTASI MASUK & KELUAR
        // ==========================================
        function openModalMutasi() {
            const barangRuangIni = state.barang.filter(b => b.ruanganId === state.activeRuanganId);
            const selectBarang = document.getElementById('selectBarangMutasi');
            selectBarang.innerHTML = barangRuangIni.length > 0 
                ? barangRuangIni.map(b => `<option value="${b.id}">${b.nama} (Tersedia: ${b.baik + b.rusakRingan + b.rusakBerat} unit)</option>`).join('')
                : `<option value="">-- Tidak ada barang di ruangan ini --</option>`;

            const ruanganLain = state.ruangan.filter(r => r.id !== state.activeRuanganId);
            const selectTujuan = document.getElementById('selectRuanganTujuan');
            selectTujuan.innerHTML = ruanganLain.map(r => `<option value="${r.id}">[${r.kode}] ${r.nama}</option>`).join('') +
                                     `<option value="GUDANG_PENGHAPUSAN">Gudang Aset / Usulan Penghapusan</option>`;

            document.getElementById('formMutasi').reset();
            toggleFormMutasi();
            openModal('modalMutasi');
        }

        function toggleFormMutasi() {
            const jenis = document.querySelector('input[name="jenisMutasi"]:checked').value;
            const keluarFields = document.getElementById('mutasiKeluarFields');
            const masukFields = document.getElementById('mutasiMasukFields');

            if (jenis === 'KELUAR') {
                keluarFields.classList.remove('hidden');
                masukFields.classList.add('hidden');
            } else {
                keluarFields.classList.add('hidden');
                masukFields.classList.remove('hidden');
            }
        }

        function prosesMutasi(e) {
            e.preventDefault();
            const jenis = document.querySelector('input[name="jenisMutasi"]:checked').value;
            const jumlah = parseInt(document.getElementById('inputMutasiJumlah').value);
            const kondisi = document.getElementById('inputMutasiKondisi').value;
            const keterangan = document.getElementById('inputMutasiKeterangan').value;
            const ruangAktif = getActiveRuangan();

            if (jenis === 'KELUAR') {
                const barangId = document.getElementById('selectBarangMutasi').value;
                const tujuanId = document.getElementById('selectRuanganTujuan').value;
                const barang = state.barang.find(b => b.id === barangId);

                if (!barang) {
                    showToast('Pilih barang yang valid untuk mutasi keluar!', 'error');
                    return;
                }

                const totalTersedia = barang.baik + barang.rusakRingan + barang.rusakBerat;
                if (jumlah > totalTersedia) {
                    showToast(`Jumlah mutasi (${jumlah}) melebihi stok tersedia (${totalTersedia})!`, 'error');
                    return;
                }

                // Kurangi stok di ruangan asal berdasarkan kondisi
                let sisaKurang = jumlah;
                if (kondisi === 'B' && barang.baik >= sisaKurang) { barang.baik -= sisaKurang; sisaKurang = 0; }
                else if (kondisi === 'RR' && barang.rusakRingan >= sisaKurang) { barang.rusakRingan -= sisaKurang; sisaKurang = 0; }
                else if (kondisi === 'RB' && barang.rusakBerat >= sisaKurang) { barang.rusakBerat -= sisaKurang; sisaKurang = 0; }
                else {
                    // Kurangi proporsional jika kondisi spesifik kurang
                    const potongB = Math.min(barang.baik, sisaKurang); barang.baik -= potongB; sisaKurang -= potongB;
                    const potongRR = Math.min(barang.rusakRingan, sisaKurang); barang.rusakRingan -= potongRR; sisaKurang -= potongRR;
                    const potongRB = Math.min(barang.rusakBerat, sisaKurang); barang.rusakBerat -= potongRB; sisaKurang -= potongRB;
                }

                // Hapus jika unit menjadi 0
                if (barang.baik + barang.rusakRingan + barang.rusakBerat === 0) {
                    state.barang = state.barang.filter(b => b.id !== barang.id);
                }

                // Tentukan nama tujuan
                let namaTujuan = 'Gudang Aset / Penghapusan';
                const ruangTujuanObj = state.ruangan.find(r => r.id === tujuanId);
                if (ruangTujuanObj) {
                    namaTujuan = `[${ruangTujuanObj.kode}] ${ruangTujuanObj.nama}`;
                    // Tambahkan barang & mutasi masuk otomatis ke ruangan tujuan!
                    state.barang.unshift({
                        ...barang,
                        id: 'BRG-' + Date.now(),
                        ruanganId: ruangTujuanObj.id,
                        baik: kondisi === 'B' ? jumlah : 0,
                        rusakRingan: kondisi === 'RR' ? jumlah : 0,
                        rusakBerat: kondisi === 'RB' ? jumlah : 0
                    });
                    state.mutasi.unshift({
                        id: 'MUT-IN-' + Date.now(),
                        ruanganId: ruangTujuanObj.id,
                        jenis: 'MASUK',
                        tanggal: getFormattedNow(),
                        kodeBarang: barang.kode,
                        namaBarang: barang.nama,
                        jumlah: jumlah,
                        kondisi: kondisi,
                        asalTujuan: `[${ruangAktif.kode}] ${ruangAktif.nama}`,
                        keterangan: keterangan,
                        petugas: ruangAktif.pjNama
                    });
                }

                // Catat mutasi keluar di ruangan ini
                state.mutasi.unshift({
                    id: 'MUT-OUT-' + Date.now(),
                    ruanganId: state.activeRuanganId,
                    jenis: 'KELUAR',
                    tanggal: getFormattedNow(),
                    kodeBarang: barang.kode,
                    namaBarang: barang.nama,
                    jumlah: jumlah,
                    kondisi: kondisi,
                    asalTujuan: namaTujuan,
                    keterangan: keterangan,
                    petugas: ruangAktif.pjNama
                });

                showToast(`Mutasi keluar ${jumlah} unit ${barang.nama} berhasil dicatat!`, 'success');

            } else {
                // MUTASI MASUK MANUAL
                const namaBarang = document.getElementById('inputMutasiNamaBarang').value;
                const kodeBarang = document.getElementById('inputMutasiKodeBarang').value || '3.10.01.99.001';
                const tahun = parseInt(document.getElementById('inputMutasiTahun').value) || 2025;
                const asal = document.getElementById('inputMutasiAsal').value;

                if (!namaBarang || !asal) {
                    showToast('Lengkapi nama barang dan asal mutasi!', 'error');
                    return;
                }

                // Tambahkan ke daftar barang ruangan
                state.barang.unshift({
                    id: 'BRG-' + Date.now(),
                    ruanganId: state.activeRuanganId,
                    kode: kodeBarang,
                    nama: namaBarang,
                    merk: 'Mutasi Masuk',
                    tahun: tahun,
                    baik: kondisi === 'B' ? jumlah : 0,
                    rusakRingan: kondisi === 'RR' ? jumlah : 0,
                    rusakBerat: kondisi === 'RB' ? jumlah : 0,
                    fotoBarang: 'https://placehold.co/300x300/e2e8f0/475569?text=Barang+Mutasi',
                    asnNama: ruangAktif.pjNama,
                    asnNip: ruangAktif.pjNip,
                    asnFoto: ruangAktif.pjFoto
                });

                // Catat riwayat mutasi masuk
                state.mutasi.unshift({
                    id: 'MUT-IN-' + Date.now(),
                    ruanganId: state.activeRuanganId,
                    jenis: 'MASUK',
                    tanggal: getFormattedNow(),
                    kodeBarang: kodeBarang,
                    namaBarang: namaBarang,
                    jumlah: jumlah,
                    kondisi: kondisi,
                    asalTujuan: asal,
                    keterangan: keterangan,
                    petugas: ruangAktif.pjNama
                });

                showToast(`Mutasi masuk ${jumlah} unit ${namaBarang} berhasil!`, 'success');
            }

            closeModal('modalMutasi');
            renderCurrentView();
        }

        // ==========================================
        // TAMBAH RUANGAN BARU
        // ==========================================
        function simpanRuangan(e) {
            e.preventDefault();
            const newId = 'R-' + Date.now();
            const newRuang = {
                id: newId,
                kode: document.getElementById('inputKodeRuang').value,
                nama: document.getElementById('inputNamaRuang').value,
                lokasi: 'Gedung Kantor Instansi',
                pjNama: document.getElementById('inputPjNama').value,
                pjNip: document.getElementById('inputPjNip').value,
                pjJabatan: 'Penanggung Jawab Ruangan',
                pjFoto: 'https://placehold.co/150x150/3b82f6/ffffff?text=ASN'
            };

            state.ruangan.push(newRuang);
            state.activeRuanganId = newId;
            closeModal('modalRuangan');
            initApp();
            showToast(`Ruangan "${newRuang.nama}" berhasil ditambahkan!`, 'success');
        }

        // ==========================================
        // UTILITIES (MODAL, PREVIEW FOTO, TOAST)
        // ==========================================
        function openModal(id, isEdit = false) {
            if (id === 'modalBarang' && !isEdit) {
                document.getElementById('modalBarangTitle').textContent = 'Tambah Barang Inventaris';
                document.getElementById('formBarang').reset();
                document.getElementById('editBarangId').value = '';
                document.getElementById('previewBarangImg').src = 'https://placehold.co/100x100/e2e8f0/64748b?text=Foto+Barang';
                document.getElementById('previewAsnImg').src = 'https://placehold.co/80x80/cbd5e1/475569?text=ASN';
            }
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function previewFoto(src, caption) {
            document.getElementById('imgPreviewBesar').src = src;
            document.getElementById('captionPreviewBesar').textContent = caption;
            openModal('modalPreviewFoto');
        }

        function previewImageUpload(input, imgId, hiddenUrlId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById(imgId).src = e.target.result;
                    if (hiddenUrlId) document.getElementById(hiddenUrlId).value = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function getFormattedNow() {
            const now = new Date();
            return now.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' +
                   now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let bgClass = 'bg-slate-800 text-white';
            let icon = 'fa-circle-info text-blue-400';
            if (type === 'success') { bgClass = 'bg-emerald-900 text-white border border-emerald-700'; icon = 'fa-circle-check text-emerald-400'; }
            if (type === 'error') { bgClass = 'bg-rose-900 text-white border border-rose-700'; icon = 'fa-circle-exclamation text-rose-400'; }

            toast.className = `${bgClass} px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 text-sm font-medium transform transition-all duration-300 translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${message}</span>`;
            
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Jalankan aplikasi saat halaman siap
        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
