<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-KIR Realtime | Kartu Inventaris Ruangan Instansi</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome untuk Ikon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @media print {
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            body {
                background-color: white;
            }
        }
    </style>
</head>
<body class="text-slate-800 antialiased selection:bg-blue-600 selection:text-white">

    <!-- Notifikasi Toast (Pengganti alert()) -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Header / Navbar -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-30 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand -->
                <div class="flex items-center gap-3">
                    <div class="bg-blue-600 p-2 rounded-lg shadow-inner">
                        <i class="fa-solid fa-building-shield text-xl text-white"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg tracking-tight leading-none">E-KIR PRO</h1>
                        <p class="text-xs text-slate-400 mt-0.5">Kartu Inventaris Ruangan Realtime</p>
                    </div>
                </div>

                <!-- Realtime Status & Action -->
                <div class="flex items-center gap-3 sm:gap-4">
                    <div class="hidden sm:flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded-full border border-slate-700">
                        <span class="relative flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                        </span>
                        <span class="text-xs font-medium text-emerald-400">Live Sync Aktif</span>
                    </div>
                    <button onclick="openModal('modalRuangan')" class="bg-blue-600 hover:bg-blue-500 text-white text-xs sm:text-sm font-medium px-3 sm:px-4 py-2 rounded-lg transition shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i>
                        <span class="hidden sm:inline">Tambah Ruangan</span>
                        <span class="sm:hidden">Ruang</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        
        <!-- Selector Ruangan & Filter Atas -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 mb-6">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                <div class="flex-1">
                    <label for="selectRuangan" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Pilih Ruangan Kantor</label>
                    <div class="relative">
                        <select id="selectRuangan" onchange="gantiRuangan(this.value)" class="w-full sm:w-96 appearance-none bg-slate-50 border border-slate-300 text-slate-900 text-sm sm:text-base font-semibold rounded-xl px-4 py-2.5 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition cursor-pointer">
                            <!-- Diisi via JS -->
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 sm:left-80 sm:right-auto flex items-center px-3 text-slate-500">
                            <i class="fa-solid fa-chevron-down text-sm"></i>
                        </div>
                    </div>
                </div>

                <!-- Tombol Aksi Utama Ruangan -->
                <div class="flex flex-wrap items-center gap-2 no-print">
                    <button onclick="openModal('modalBarang')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-box-open"></i> Tambah Barang
                    </button>
                    <button onclick="openModalMutasi()" class="bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-right-left"></i> Catat Mutasi
                    </button>
                    <button onclick="window.print()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2.5 rounded-xl transition flex items-center gap-2" title="Cetak Kartu Inventaris Ruangan">
                        <i class="fa-solid fa-print"></i> <span class="hidden sm:inline">Cetak KIR</span>
                    </button>
                </div>
            </div>

            <!-- Profil Ruangan & ASN Penanggung Jawab -->
            <div id="profilRuanganContainer" class="pt-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <!-- Diisi via JS -->
            </div>
        </div>

        <!-- Ringkasan Statistik Realtime -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-cubes"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Total Unit Barang</p>
                    <h3 id="statTotalUnit" class="text-2xl font-bold text-slate-800 mt-0.5">0</h3>
                </div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Kondisi Baik (B)</p>
                    <h3 id="statBaik" class="text-2xl font-bold text-emerald-600 mt-0.5">0</h3>
                </div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Rusak Ringan (RR)</p>
                    <h3 id="statRusakRingan" class="text-2xl font-bold text-amber-600 mt-0.5">0</h3>
                </div>
            </div>
            <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Rusak Berat (RB)</p>
                    <h3 id="statRusakBerat" class="text-2xl font-bold text-rose-600 mt-0.5">0</h3>
                </div>
            </div>
        </div>

        <!-- Tabs Navigasi: Daftar Barang vs Daftar Mutasi -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 px-4 sm:px-6 pt-3 bg-slate-50/50 no-print">
                <div class="flex gap-2 overflow-x-auto">
                    <button onclick="switchTab('barang')" id="tabBtnBarang" class="px-4 py-3 text-sm font-semibold border-b-2 border-blue-600 text-blue-600 whitespace-nowrap transition flex items-center gap-2">
                        <i class="fa-solid fa-list-check"></i> Daftar Barang Inventaris
                    </button>
                    <button onclick="switchTab('mutasi')" id="tabBtnMutasi" class="px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-500 hover:text-slate-700 whitespace-nowrap transition flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left"></i> Riwayat Mutasi Masuk & Keluar
                        <span id="badgeMutasiCount" class="bg-slate-200 text-slate-700 text-xs px-2 py-0.5 rounded-full">0</span>
                    </button>
                </div>

                <!-- Pencarian Cepat -->
                <div class="py-2 sm:py-0 mb-2 sm:mb-0">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="searchInput" onkeyup="renderCurrentView()" placeholder="Cari nama / kode barang..." class="w-full sm:w-64 pl-8 pr-3 py-1.5 text-sm bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
            </div>

            <!-- KONTEN TAB 1: DAFTAR BARANG INVENTARIS -->
            <div id="viewBarang" class="p-4 sm:p-6">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b-2 border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50">
                                <th class="py-3.5 px-4 rounded-tl-lg">Foto & Nama Barang</th>
                                <th class="py-3.5 px-4">Kode / Merk</th>
                                <th class="py-3.5 px-4 text-center">Tahun</th>
                                <th class="py-3.5 px-4 text-center">Jumlah</th>
                                <th class="py-3.5 px-4">Rincian Kondisi</th>
                                <th class="py-3.5 px-4">ASN Pengguna</th>
                                <th class="py-3.5 px-4 text-right rounded-tr-lg no-print">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tabelBarangBody" class="divide-y divide-slate-100 text-sm">
                            <!-- Diisi via JS -->
                        </tbody>
                    </table>
                </div>
                <div id="emptyBarangState" class="hidden py-12 text-center">
                    <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h4 class="text-slate-700 font-semibold">Belum ada data barang</h4>
                    <p class="text-slate-500 text-sm mt-1">Tambahkan barang inventaris baru atau mutasi masuk ke ruangan ini.</p>
                </div>
            </div>

            <!-- KONTEN TAB 2: DAFTAR MUTASI MASUK & KELUAR -->
            <div id="viewMutasi" class="hidden p-4 sm:p-6">
                <!-- Filter Tipe Mutasi -->
                <div class="flex flex-wrap items-center gap-2 mb-4 no-print">
                    <button onclick="setFilterMutasi('SEMUA')" id="filterMutasiSemua" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-white transition">Semua Mutasi</button>
                    <button onclick="setFilterMutasi('MASUK')" id="filterMutasiMasuk" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition">
                        <i class="fa-solid fa-arrow-down-left text-emerald-600 mr-1"></i> Mutasi Masuk
                    </button>
                    <button onclick="setFilterMutasi('KELUAR')" id="filterMutasiKeluar" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-rose-50 hover:text-rose-700 transition">
                        <i class="fa-solid fa-arrow-up-right text-rose-600 mr-1"></i> Mutasi Keluar
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b-2 border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-50">
                                <th class="py-3.5 px-4 rounded-tl-lg">Waktu & Jenis</th>
                                <th class="py-3.5 px-4">Barang Inventaris</th>
                                <th class="py-3.5 px-4 text-center">Unit</th>
                                <th class="py-3.5 px-4">Asal / Tujuan Ruangan</th>
                                <th class="py-3.5 px-4">Keterangan & Petugas</th>
                            </tr>
                        </thead>
                        <tbody id="tabelMutasiBody" class="divide-y divide-slate-100 text-sm">
                            <!-- Diisi via JS -->
                        </tbody>
                    </table>
                </div>
                <div id="emptyMutasiState" class="hidden py-12 text-center">
                    <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
                        <i class="fa-solid fa-right-left"></i>
                    </div>
                    <h4 class="text-slate-700 font-semibold">Belum ada riwayat mutasi</h4>
                    <p class="text-slate-500 text-sm mt-1">Catatan perpindahan barang masuk dan keluar ruangan akan muncul di sini.</p>
                </div>
            </div>
        </div>
    </main>

    <!-- ===================================================================== -->
    <!-- MODALS                                                                -->
    <!-- ===================================================================== -->

    <!-- MODAL 1: Tambah / Edit Barang -->
    <div id="modalBarang" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full overflow-hidden my-8">
            <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center">
                <h3 id="modalBarangTitle" class="font-bold text-lg">Tambah Barang Inventaris</h3>
                <button onclick="closeModal('modalBarang')" class="text-slate-400 hover:text-white transition"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <form id="formBarang" onsubmit="simpanBarang(event)" class="p-6 space-y-4 max-h-[80vh] overflow-y-auto">
                <input type="hidden" id="editBarangId">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Kode Barang / Register *</label>
                        <input type="text" id="inputKodeBarang" required placeholder="Contoh: 3.10.01.02.001" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Barang *</label>
                        <input type="text" id="inputNamaBarang" required placeholder="Contoh: Laptop Kerja Core i7" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Merk / Tipe / Spesifikasi</label>
                        <input type="text" id="inputMerkBarang" placeholder="Contoh: Lenovo ThinkPad T14" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Tahun Perolehan *</label>
                        <input type="number" id="inputTahunBarang" required min="1990" max="2030" value="2024" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                </div>

                <!-- Kondisi & Jumlah Unit -->
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Rincian Jumlah Unit Berdasarkan Kondisi</label>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-emerald-700 mb-1">Baik (B)</label>
                            <input type="number" id="inputKondisiBaik" min="0" value="1" required class="w-full px-3 py-2 text-sm border border-emerald-300 bg-white rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-amber-700 mb-1">Rusak Ringan (RR)</label>
                            <input type="number" id="inputKondisiRR" min="0" value="0" required class="w-full px-3 py-2 text-sm border border-amber-300 bg-white rounded-lg focus:ring-2 focus:ring-amber-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-rose-700 mb-1">Rusak Berat (RB)</label>
                            <input type="number" id="inputKondisiRB" min="0" value="0" required class="w-full px-3 py-2 text-sm border border-rose-300 bg-white rounded-lg focus:ring-2 focus:ring-rose-500 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- Foto Barang -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Foto Barang (Unggah File atau URL Gambar)</label>
                    <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                        <input type="file" id="fileFotoBarang" accept="image/*" onchange="previewImageUpload(this, 'previewBarangImg', 'inputFotoBarangUrl')" class="text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
                        <span class="text-xs text-slate-400">atau</span>
                        <input type="url" id="inputFotoBarangUrl" oninput="document.getElementById('previewBarangImg').src = this.value || 'https://placehold.co/100x100/e2e8f0/64748b?text=Foto+Barang'" placeholder="https://..." class="flex-1 w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none">
                    </div>
                    <img id="previewBarangImg" src="https://placehold.co/100x100/e2e8f0/64748b?text=Foto+Barang" alt="Preview" class="mt-2 h-20 w-20 object-cover rounded-lg border border-slate-200">
                </div>

                <!-- ASN Pengguna Barang -->
                <div class="border-t border-slate-200 pt-4">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">ASN Pengguna / Pemegang Barang</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama ASN & Gelar *</label>
                            <input type="text" id="inputAsnNama" required placeholder="Contoh: Budi Santoso, S.Kom" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">NIP ASN *</label>
                            <input type="text" id="inputAsnNip" required placeholder="Contoh: 19880512 201503 1 002" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Foto ASN Pengguna</label>
                        <div class="flex items-center gap-3">
                            <img id="previewAsnImg" src="https://placehold.co/80x80/cbd5e1/475569?text=ASN" alt="ASN" class="h-12 w-12 rounded-full object-cover border border-slate-300">
                            <input type="file" id="fileFotoAsn" accept="image/*" onchange="previewImageUpload(this, 'previewAsnImg', 'inputFotoAsnUrl')" class="text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer">
                            <input type="hidden" id="inputFotoAsnUrl">
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modalBarang')" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-xl transition">Batal</button>
                    <button type="submit" class="px-5 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition">Simpan Data Barang</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2: Catat Mutasi Barang (Masuk / Keluar) -->
    <div id="modalMutasi" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full overflow-hidden">
            <div class="px-6 py-4 bg-amber-500 text-white flex justify-between items-center">
                <h3 class="font-bold text-lg flex items-center gap-2"><i class="fa-solid fa-right-left"></i> Catat Mutasi Barang</h3>
                <button onclick="closeModal('modalMutasi')" class="text-amber-100 hover:text-white transition"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <form id="formMutasi" onsubmit="prosesMutasi(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Jenis Mutasi *</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="jenisMutasi" value="KELUAR" checked onchange="toggleFormMutasi()" class="peer sr-only">
                            <div class="p-3 text-center rounded-xl border-2 border-slate-200 peer-checked:border-rose-500 peer-checked:bg-rose-50 peer-checked:text-rose-700 font-semibold text-sm transition">
                                <i class="fa-solid fa-arrow-up-right mr-1"></i> Mutasi Keluar
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="jenisMutasi" value="MASUK" onchange="toggleFormMutasi()" class="peer sr-only">
                            <div class="p-3 text-center rounded-xl border-2 border-slate-200 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-700 font-semibold text-sm transition">
                                <i class="fa-solid fa-arrow-down-left mr-1"></i> Mutasi Masuk
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Jika Mutasi Keluar: Pilih Barang yang ada di ruangan ini -->
                <div id="mutasiKeluarFields" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Pilih Barang dari Ruangan Ini *</label>
